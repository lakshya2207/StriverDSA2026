{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile and run",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "(if not exist bin mkdir bin) && g++ -std=c++20 -o \"bin\\${fileBasenameNoExtension}\" \"${file}\" && bin\\${fileBasenameNoExtension} < input.txt > output.txt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "auto-commit watcher",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-WindowStyle",
        "Hidden",
        "-File",
        "${workspaceFolder}\\scripts\\auto-commit-watcher.ps1"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
